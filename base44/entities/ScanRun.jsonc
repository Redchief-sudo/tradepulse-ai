{
  "name": "ScanRun",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "scan_run_id": {
      "type": "string",
      "description": "Canonical scan-cycle identifier (stable across retries)"
    },
    "scan_generation": {
      "type": "number",
      "description": "Monotonically increasing generation counter \u2014 incremented on every external call. After each async operation, the scan verifies this generation is still active. If another scan superseded it, the result is discarded."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat timestamp \u2014 updated periodically during the scan. A scan is considered stale only when this stops advancing, not simply because started_at is old."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "trigger_source": {
      "type": "string",
      "enum": [
        "scheduled",
        "dashboard",
        "autonomous_page",
        "manual"
      ],
      "default": "scheduled"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "no_candidates",
        "broker_unavailable",
        "superseded"
      ],
      "default": "running",
      "description": "superseded = a newer scan generation invalidated this one \u2014 its LLM results were discarded"
    },
    "candidates_found": {
      "type": "number",
      "default": 0
    },
    "proposals_created": {
      "type": "number",
      "default": 0
    },
    "proposals_vetoed": {
      "type": "number",
      "default": 0
    },
    "trades_attempted": {
      "type": "number",
      "default": 0
    },
    "trades_filled": {
      "type": "number",
      "default": 0
    },
    "trades_rejected": {
      "type": "number",
      "default": 0
    },
    "candidates_accounted": {
      "type": "number",
      "default": 0
    },
    "candidate_dispositions": {
      "type": "string",
      "description": "JSON map of every executable candidate symbol to its terminal scan disposition"
    },
    "no_trade_reason": {
      "type": "string",
      "description": "Explicit aggregate reason when a terminal scan places no trade"
    },
    "accepted_fills": { "type": "number", "default": 0 },
    "settlement_completed": { "type": "number", "default": 0 },
    "settlement_pending": { "type": "number", "default": 0 },
    "settlement_failed": { "type": "number", "default": 0 },
    "settlement_integrity_blocked": { "type": "number", "default": 0 },
    "unaccounted_fills": { "type": "number", "default": 0 },
    "market_regime": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "market_summary": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "scan_run_id",
    "started_at",
    "trigger_source",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}
