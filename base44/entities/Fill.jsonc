{
  "name": "Fill",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "fill_id": {
      "type": "string",
      "description": "Unique fill identifier \u2014 idempotency key for settlement"
    },
    "broker_order_id": {
      "type": "string"
    },
    "client_order_id": {
      "type": "string"
    },
    "trade_intent_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "filled_quantity": {
      "type": "number"
    },
    "filled_price": {
      "type": "number"
    },
    "notional": {
      "type": "number"
    },
    "commission": {
      "type": "number"
    },
    "fees": {
      "type": "number"
    },
    "slippage": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "venue": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "internal_paper",
        "broker_paper",
        "paper",
        "shadow_live",
        "live"
      ]
    },
    "asset_class": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "fill_id",
    "trade_intent_id",
    "symbol",
    "side",
    "filled_quantity",
    "filled_price",
    "execution_mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}