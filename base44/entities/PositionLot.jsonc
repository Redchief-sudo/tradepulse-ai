{
  "name": "PositionLot",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "lot_id": {
      "type": "string",
      "description": "Unique lot identifier"
    },
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    },
    "originating_fill_id": {
      "type": "string",
      "description": "Fill ID that opened this lot"
    },
    "position_side": {
      "type": "string",
      "enum": ["long", "short"],
      "default": "long",
      "description": "Direction of the open lot. Legacy lots without this field are long."
    },
    "quantity_opened": {
      "type": "number"
    },
    "quantity_remaining": {
      "type": "number"
    },
    "acquisition_price": {
      "type": "number"
    },
    "acquisition_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "partially_closed",
        "closed"
      ],
      "default": "open"
    },
    "realized_pnl": {
      "type": "number",
      "default": 0
    },
    "closure_fill_ids": {
      "type": "string",
      "description": "JSON array of fill IDs that closed (part of) this lot"
    },
    "cost_basis_method": {
      "type": "string",
      "enum": [
        "fifo",
        "lifo",
        "specific_id"
      ],
      "default": "fifo"
    },
    "provenance_source": {
      "type": "string",
      "enum": [
        "app_fill",
        "broker_import",
        "manual_entry",
        "backtest"
      ],
      "default": "app_fill",
      "description": "How this lot was created: app_fill (from an executed TradeIntent), broker_import (synced from broker without a matching fill), manual_entry (user added), backtest (replay)"
    },
    "provenance_quality": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "ambiguous"
      ],
      "default": "verified",
      "description": "verified = matched to a fill record, unverified = broker-imported without fill evidence, ambiguous = could not be definitively matched"
    }
  },
  "required": [
    "user_id",
    "lot_id",
    "symbol",
    "quantity_opened",
    "acquisition_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
