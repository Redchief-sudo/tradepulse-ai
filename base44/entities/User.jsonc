{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "broker": {
      "type": "string",
      "description": "Selected broker platform (alpaca, ibkr, tradestation, custom) \u2014 non-sensitive"
    },
    "broker_connected": {
      "type": "boolean",
      "description": "Whether the user has active broker credentials stored server-side",
      "default": false
    },
    "broker_mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "description": "Trading mode: paper (simulation) or live (real orders) \u2014 non-sensitive"
    },
    "stop_loss_pct": {
      "type": "number",
      "description": "Default stop-loss percentage threshold for auto-exit"
    },
    "trade_profile": {
      "type": "string",
      "enum": [
        "aggressive",
        "balanced",
        "conservative"
      ],
      "description": "AI trading risk profile governing position limits and confidence thresholds"
    },
    "promotion_mode": {
      "type": "string",
      "enum": [
        "research",
        "manual_approval",
        "automatic"
      ],
      "default": "automatic",
      "description": "Model governance promotion mode: research (validate only, never promote), manual_approval (human approves proven candidates), automatic (auto-promote if proven)"
    },
    "auto_promote_enabled": {
      "type": "boolean",
      "default": false,
      "description": "If true, notify when configured paper-trade count and win-rate readiness thresholds are both met; never enables live trading"
    },
    "auto_promote_min_trades": {
      "type": "number",
      "default": 20,
      "description": "Minimum number of closed paper trades required for a live-readiness notification"
    },
    "auto_promote_min_win_rate": {
      "type": "number",
      "default": 60,
      "description": "Minimum win-rate percentage (0-100) required for a live-readiness notification"
    },
    "auto_promote_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the live-readiness notification fired \u2014 set once, prevents re-triggering"
    },
    "telegram_chat_id": {
      "type": "string",
      "description": "Telegram chat ID for trade notifications \u2014 non-sensitive"
    },
    "telegram_notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether Telegram trade notifications are enabled"
    },
    "ml_weights": {
      "type": "object",
      "description": "Self-learning adjusted 5-factor weights (cached from global champion)",
      "properties": {
        "technical": {
          "type": "number"
        },
        "fundamental": {
          "type": "number"
        },
        "sentiment": {
          "type": "number"
        },
        "momentum": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        }
      }
    },
    "trading_active": {
      "type": "boolean",
      "default": false,
      "description": "User toggle \u2014 whether autonomous scanning is enabled. The authoritative state is trading_session_state."
    },
    "trading_session_state": {
      "type": "string",
      "enum": [
        "disabled",
        "active",
        "risk_stopped",
        "system_degraded",
        "broker_unavailable",
        "market_closed",
        "manually_stopped"
      ],
      "default": "disabled",
      "description": "Hard session state machine \u2014 the authoritative trading state. Not just active/inactive: includes risk_stopped (kill switch tripped), system_degraded (scan/data failure), broker_unavailable, market_closed, manually_stopped."
    },
    "kill_switch_reason": {
      "type": "string",
      "description": "Why the kill switch tripped (e.g. DAILY_LOSS_LIMIT, BROKER_UNAVAILABLE, SYSTEM_DEGRADED)"
    },
    "kill_switch_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the kill switch tripped"
    },
    "kill_switch_reset_required": {
      "type": "boolean",
      "default": false,
      "description": "If true, the user must manually reset before trading can resume \u2014 prevents auto-re-enable on the same day"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
