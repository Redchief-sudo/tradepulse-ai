{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "broker": {
      "type": "string",
      "description": "Selected broker platform (alpaca, ibkr, tradestation, custom)"
    },
    "broker_api_key": {
      "type": "string",
      "description": "Broker API key"
    },
    "broker_api_secret": {
      "type": "string",
      "description": "Broker API secret"
    },
    "broker_mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "description": "Trading mode: paper (simulation) or live (real orders)"
    },
    "stop_loss_pct": {
      "type": "number",
      "description": "Default stop-loss percentage threshold for auto-exit"
    },
    "trade_profile": {
      "type": "string",
      "enum": [
        "aggressive",
        "balanced",
        "conservative"
      ],
      "description": "AI trading risk profile governing position limits and confidence thresholds"
    },
    "ml_weights": {
      "type": "object",
      "description": "Self-learning adjusted 5-factor weights (technical/fundamental/sentiment/momentum/risk) persisted across autonomous scan cycles",
      "properties": {
        "technical": {
          "type": "number"
        },
        "fundamental": {
          "type": "number"
        },
        "sentiment": {
          "type": "number"
        },
        "momentum": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}