{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "broker": {
      "type": "string",
      "description": "Selected broker platform (alpaca, ibkr, tradestation, custom)"
    },
    "broker_api_key": {
      "type": "string",
      "description": "Broker API key"
    },
    "broker_api_secret": {
      "type": "string",
      "description": "Broker API secret"
    },
    "broker_mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ],
      "description": "Trading mode: paper (simulation) or live (real orders)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}