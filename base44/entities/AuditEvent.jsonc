{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "event_type": {
      "type": "string",
      "description": "order_submitted, fill_recorded, settlement_completed, reconciliation_drift, stale_order, duplicate_attempt, daily_loss_breach, kill_switch_activated, broker_outage, stale_data_block, regime_change, model_promoted, model_rollback"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "default": "info"
    },
    "correlation_id": {
      "type": "string",
      "description": "Links related events across the execution pipeline (intent \u2192 order \u2192 fills \u2192 settlement)"
    },
    "entity_type": {
      "type": "string",
      "description": "TradeIntent, Fill, Trade, Holding, StrategyModel, etc."
    },
    "entity_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "JSON string with structured event payload"
    },
    "broker_api_latency_ms": {
      "type": "number",
      "description": "Broker API call latency in milliseconds (for observability)"
    }
  },
  "required": [
    "user_id",
    "event_type",
    "severity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}