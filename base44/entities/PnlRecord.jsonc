{
  "name": "PnlRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "symbol": {
      "type": "string"
    },
    "asset_class": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "daily_return_pct": {
      "type": "number"
    },
    "cumulative_pnl_pct": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "date",
    "symbol"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}