{
  "name": "TradeIntent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy (e.g. alpaca_paper, alpaca_live, retirement)"
    },
    "trade_intent_id": {
      "type": "string",
      "description": "Canonical idempotency key \u2014 stable across retries"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Caller-provided stable key (decision_id+signal_timestamp+symbol+side) \u2014 prevents duplicate orders on retry"
    },
    "strategy_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    },
    "symbol": {
      "type": "string"
    },
    "native_asset_id": {
      "type": "string"
    },
    "broker": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "order_type": {
      "type": "string",
      "enum": [
        "market",
        "limit",
        "stop",
        "stop_limit"
      ],
      "default": "market"
    },
    "requested_quantity": {
      "type": "number"
    },
    "requested_notional": {
      "type": "number"
    },
    "limit_price": {
      "type": "number"
    },
    "stop_price": {
      "type": "number"
    },
    "time_in_force": {
      "type": "string",
      "enum": [
        "day",
        "gtc",
        "ioc",
        "fok"
      ],
      "default": "day"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "internal_paper",
        "broker_paper",
        "paper",
        "shadow_live",
        "live"
      ],
      "default": "internal_paper"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "risk_approved",
        "submitted",
        "accepted",
        "partially_filled",
        "filled",
        "settled",
        "rejected",
        "canceled",
        "expired",
        "failed"
      ],
      "default": "proposed"
    },
    "settlement_state": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "projected",
        "settled"
      ],
      "default": "pending",
      "description": "Durable settlement state machine \u2014 only one worker may transition pending \u2192 claimed. Enables crash recovery and prevents double-settlement."
    },
    "settlement_owner": {
      "type": "string",
      "description": "Worker ID that claimed the settlement \u2014 used for atomic claim verification"
    },
    "settlement_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "settlement_version": {
      "type": "number",
      "description": "Optimistic concurrency version \u2014 incremented on each state transition"
    },
    "broker_terminal_status": {
      "type": "string",
      "description": "Broker's terminal disposition (filled, canceled, rejected, expired, replaced) \u2014 preserved separately from settlement status so partial fills + cancellations are both visible"
    },
    "unfilled_quantity": {
      "type": "number",
      "description": "Requested quantity minus filled quantity at terminal state \u2014 the portion not filled (canceled/rejected remainder)"
    },
    "risk_snapshot": {
      "type": "string"
    },
    "portfolio_snapshot": {
      "type": "string"
    },
    "signal_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "broker_order_id": {
      "type": "string"
    },
    "client_order_id": {
      "type": "string"
    },
    "filled_quantity": {
      "type": "number"
    },
    "filled_avg_price": {
      "type": "number"
    },
    "commission": {
      "type": "number"
    },
    "fees": {
      "type": "number"
    },
    "slippage": {
      "type": "number"
    },
    "realized_pnl": {
      "type": "number"
    },
    "company_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "reasoning": {
      "type": "string"
    },
    "ml_score": {
      "type": "number"
    },
    "technical_score": {
      "type": "number"
    },
    "momentum_score": {
      "type": "number"
    },
    "risk_score": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "trade_intent_id",
    "symbol",
    "side",
    "requested_quantity",
    "execution_mode",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}