{
  "name": "ScanLock",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "lock_key": {
      "type": "string",
      "description": "Lock key (e.g. scan-{userId}-{runId}) \u2014 identifies the scan slot"
    },
    "owner_token": {
      "type": "string",
      "description": "Unique UUID identifying the lock owner \u2014 used to verify ownership during heartbeats"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lock was acquired \u2014 the earliest lock wins in a race"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lock expires if not renewed \u2014 stale locks are reclaimable"
    },
    "heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat from the lock owner \u2014 a lock is stale when this stops advancing"
    },
    "scan_run_id": {
      "type": "string",
      "description": "The ScanRun ID associated with this lock"
    }
  },
  "required": [
    "user_id",
    "lock_key",
    "owner_token",
    "acquired_at",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}