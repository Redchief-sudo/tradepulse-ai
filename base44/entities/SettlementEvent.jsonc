{
  "name": "SettlementEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "event_id": {
      "type": "string",
      "description": "Unique event identifier \u2014 idempotency key for settlement. For broker fills: broker_fill_id. For paper fills: generated. One broker fill maps to exactly one SettlementEvent."
    },
    "trade_intent_id": {
      "type": "string",
      "description": "The TradeIntent this event settles"
    },
    "broker_order_id": {
      "type": "string"
    },
    "broker_fill_id": {
      "type": "string",
      "description": "The broker's fill ID (for broker_paper/live mode)"
    },
    "client_order_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "type": "number",
      "description": "Filled quantity for this event"
    },
    "price": {
      "type": "number",
      "description": "Filled price for this event"
    },
    "notional": {
      "type": "number",
      "description": "quantity * price"
    },
    "commission": {
      "type": "number"
    },
    "fees": {
      "type": "number"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the fill occurred (broker timestamp or simulation time)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "pending = waiting for settlement processor; processing = claimed by a worker; completed = fully projected (lots, cash, holding, trade); failed = projection error (retryable)"
    },
    "processing_owner": {
      "type": "string",
      "description": "Worker ID that claimed this event for processing"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When processing started \u2014 used for stale lease detection"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string",
      "description": "Error message if status = failed"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "internal_paper",
        "broker_paper",
        "paper",
        "shadow_live",
        "live"
      ]
    },
    "asset_class": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "arrival_price": {
      "type": "number"
    },
    "decision_price": {
      "type": "number"
    },
    "submission_price": {
      "type": "number"
    },
    "first_fill_price": {
      "type": "number"
    },
    "vwap_fill_price": {
      "type": "number"
    },
    "implementation_shortfall": {
      "type": "number"
    },
    "fill_latency_ms": {
      "type": "number"
    },
    "integrity_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if financial integrity verification passed after projection"
    },
    "realized_pnl": {
      "type": "number",
      "description": "Realized P&L computed during settlement (sells only)"
    }
  },
  "required": [
    "user_id",
    "event_id",
    "trade_intent_id",
    "symbol",
    "side",
    "quantity",
    "price",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}