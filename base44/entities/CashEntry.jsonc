{
  "name": "CashEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "account_opening",
        "deposit",
        "withdrawal",
        "buy",
        "sell",
        "commission",
        "fee",
        "adjustment",
        "dividend",
        "reservation",
        "reservation_release"
      ],
      "description": "Type of cash flow entry. account_opening = immutable opening balance (exactly one per user); reservation = cash held for a pending order; reservation_release = reservation returned (filled or canceled)"
    },
    "amount": {
      "type": "number",
      "description": "Positive for credit (cash in), negative for debit (cash out). Reservations are negative; releases are positive."
    },
    "balance_after": {
      "type": "number",
      "description": "Cash balance after this entry was applied. Informational only \u2014 under concurrent writes it may be stale. The authoritative balance is always sum(amount) across all entries."
    },
    "symbol": {
      "type": "string",
      "description": "Symbol for trade-related entries (null for deposits/adjustments)"
    },
    "trade_intent_id": {
      "type": "string"
    },
    "fill_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "entry_type",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}