{
  "name": "ScanRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "pending = waiting for scan coordinator; processing = coordinator claimed it; completed = scan finished; failed = scan error"
    },
    "trigger_source": {
      "type": "string",
      "enum": [
        "dashboard",
        "manual",
        "scheduled"
      ],
      "default": "dashboard",
      "description": "Who requested this scan \u2014 dashboard (Start button), manual (explicit), scheduled (workflow auto)"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was created"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan_run_id": {
      "type": "string",
      "description": "The ScanRun ID produced by this request"
    },
    "error": {
      "type": "string"
    },
    "processing_owner": {
      "type": "string",
      "description": "Worker ID that claimed this request"
    }
  },
  "required": [
    "user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}