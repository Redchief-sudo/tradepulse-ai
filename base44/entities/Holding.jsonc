{
  "name": "Holding",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "shares": {
      "type": "number"
    },
    "avg_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "sector": {
      "type": "string"
    },
    "day_change_percent": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    },
    "reconciliation_blocked": {
      "type": "boolean",
      "default": false,
      "description": "If true, automated changes are frozen for this symbol \u2014 reconciliation could not match the broker position to app fills. Requires manual review to unblock."
    },
    "reconciliation_blocked_reason": {
      "type": "string",
      "description": "Why reconciliation blocked this position (e.g. EXTERNALLY_CLOSED_NO_MATCH, QTY_DRIFT_UNRESOLVED)"
    },
    "reconciliation_blocked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "symbol",
    "shares",
    "avg_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
