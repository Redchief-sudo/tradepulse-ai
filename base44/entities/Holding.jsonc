{
  "name": "Holding",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "shares": {
      "type": "number"
    },
    "avg_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "sector": {
      "type": "string"
    },
    "day_change_percent": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    }
  },
  "required": [
    "user_id",
    "symbol",
    "shares",
    "avg_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}