{
  "name": "Holding",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "shares": {
      "type": "number"
    },
    "avg_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "sector": {
      "type": "string"
    },
    "day_change_percent": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    }
  },
  "required": [
    "symbol",
    "shares",
    "avg_price"
  ]
}