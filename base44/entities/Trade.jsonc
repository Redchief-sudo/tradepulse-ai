{
  "name": "Trade",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "shares": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "total_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "ai_recommended": {
      "type": "boolean"
    },
    "broker_order_id": {
      "type": "string"
    },
    "client_order_id": {
      "type": "string"
    },
    "filled_qty": {
      "type": "number"
    },
    "filled_avg_price": {
      "type": "number"
    },
    "order_status": {
      "type": "string"
    },
    "commission": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "realized_pnl": {
      "type": "number"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "order_summary",
        "manual_trade"
      ],
      "default": "order_summary",
      "description": "Labels this Trade as a derived order-level summary \u2014 the Fill ledger is the immutable execution record. Analytics should read individual fills for execution-quality metrics."
    },
    "fill_count": {
      "type": "number",
      "description": "Number of individual fills that comprise this order summary"
    },
    "first_fill_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_fill_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "symbol",
    "action",
    "shares",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
