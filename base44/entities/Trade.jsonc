{
  "name": "Trade",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "shares": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "total_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "ai_recommended": {
      "type": "boolean"
    },
    "broker_order_id": {
      "type": "string",
      "description": "Broker-assigned order id once submitted"
    },
    "client_order_id": {
      "type": "string",
      "description": "Idempotency key assigned by the execution engine"
    },
    "filled_qty": {
      "type": "number",
      "description": "Quantity actually filled by the broker"
    },
    "filled_avg_price": {
      "type": "number",
      "description": "Average fill price reported by the broker"
    },
    "order_status": {
      "type": "string",
      "description": "Terminal/paper fill status: filled, paper_filled, rejected, pending, reconciled_external, etc."
    },
    "commission": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "description": "Origin of the trade: autonomous, stoploss, dashboard_exit, ai_assistant, autonomous_ui, stoploss_ui, manual, reconciliation"
    },
    "realized_pnl": {
      "type": "number",
      "description": "Realized P&L for sell trades (exit price - avg cost) * shares"
    }
  },
  "required": [
    "symbol",
    "action",
    "shares",
    "price"
  ]
}