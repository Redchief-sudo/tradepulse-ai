{
  "name": "MarketDataCredential",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["coingecko", "coinmarketcap"] },
    "api_key": { "type": "string" },
    "api_plan": { "type": "string", "enum": ["demo", "pro", "standard"] },
    "status": { "type": "string", "enum": ["active", "invalid", "disconnected"], "default": "active" },
    "validated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "provider", "api_key", "status"],
  "rls": { "read": false, "create": false, "update": false, "delete": false }
}
