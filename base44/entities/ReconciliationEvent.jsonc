{
  "name": "ReconciliationEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "matched",
        "qty_drift",
        "price_drift",
        "externally_closed",
        "new_from_broker",
        "broker_unreachable",
        "reconciliation_adjustment"
      ]
    },
    "symbol": {
      "type": "string"
    },
    "app_qty": {
      "type": "number"
    },
    "broker_qty": {
      "type": "number"
    },
    "app_avg_price": {
      "type": "number"
    },
    "broker_avg_price": {
      "type": "number"
    },
    "app_current_price": {
      "type": "number"
    },
    "broker_current_price": {
      "type": "number"
    },
    "action_taken": {
      "type": "string"
    },
    "realized_pnl": {
      "type": "number"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "run_timestamp",
    "event_type",
    "symbol"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}