{
  "name": "StrategyModel",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "model_id": {
      "type": "string",
      "description": "Canonical model identifier (e.g. alpha-factor-v1)"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g. 1.2.0)"
    },
    "parent_version": {
      "type": "string",
      "description": "Parent model version for rollback lineage"
    },
    "weights": {
      "type": "object",
      "description": "5-factor scoring weights (sum to 100)",
      "properties": {
        "technical": {
          "type": "number"
        },
        "fundamental": {
          "type": "number"
        },
        "sentiment": {
          "type": "number"
        },
        "momentum": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "champion",
        "challenger",
        "retired",
        "rejected"
      ],
      "default": "challenger"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "auto_promoted"
      ],
      "default": "pending"
    },
    "in_sample_metrics": {
      "type": "string",
      "description": "JSON: reasoning, hypothesis, optimizer trace, sampleSize, factor analysis"
    },
    "out_of_sample_metrics": {
      "type": "string",
      "description": "JSON: championCorr, candidateCorr, improvement, pValue, oosSize"
    },
    "champion_metrics": {
      "type": "string",
      "description": "JSON: current champion's OOS metrics for comparison"
    },
    "improvement_pct": {
      "type": "number",
      "description": "OOS improvement over champion (correlation delta)"
    },
    "p_value": {
      "type": "number",
      "description": "Statistical significance of improvement (bootstrap)"
    },
    "sample_size": {
      "type": "number",
      "description": "Number of labeled outcomes used for validation"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollback_reason": {
      "type": "string"
    },
    "regime": {
      "type": "string",
      "description": "Market regime this model is champion for ('all' = global, or specific regime like 'low_vol_bull', 'high_vol_bear', etc.)"
    },
    "approved_by": {
      "type": "string",
      "description": "User id who approved the promotion (null for auto_promoted, user.id for manual approval)"
    },
    "rollback_path": {
      "type": "string",
      "description": "Immutable audit trail: version lineage chain (e.g. '1.0.0 \u2192 1.1.0 \u2192 1.2.0')"
    }
  },
  "required": [
    "user_id",
    "model_id",
    "version",
    "weights",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}