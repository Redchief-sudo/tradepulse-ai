{
  "name": "AITradeDecision",
  "type": "object",
  "properties": {
    "settlement_event_id": {
      "type": "string",
      "description": "SettlementEvent idempotency key that produced this decision projection"
    },
    "trade_intent_id": {
      "type": "string",
      "description": "Logical learning-unit identity; all partial entry fills aggregate to this decision"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 every query must filter by this"
    },
    "portfolio_id": {
      "type": "string",
      "description": "Portfolio identifier for multi-portfolio tenancy"
    },
    "symbol": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "forex",
        "commodities",
        "fixed_income"
      ],
      "default": "stocks"
    },
    "regime": {
      "type": "string",
      "description": "Market regime at execution time (low_vol_bull, high_vol_bear, range_bound_choppy, liquidity_crisis, transition) \u2014 used for regime-specific champion governance"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "shares": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "position_value": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "target_price": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "reasoning": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "executed",
        "skipped"
      ]
    },
    "ml_score": {
      "type": "number"
    },
    "technical_score": {
      "type": "number"
    },
    "fundamental_score": {
      "type": "number"
    },
    "sentiment_score": {
      "type": "number"
    },
    "momentum_score": {
      "type": "number"
    },
    "risk_score": {
      "type": "number"
    },
    "return_5m": {
      "type": "number"
    },
    "return_1h": {
      "type": "number"
    },
    "return_1d": {
      "type": "number"
    },
    "return_5d": {
      "type": "number"
    },
    "realized_return": {
      "type": "number"
    },
    "benchmark_return": {
      "type": "number"
    },
    "max_adverse_excursion": {
      "type": "number"
    },
    "max_favorable_excursion": {
      "type": "number"
    },
    "holding_period_minutes": {
      "type": "number"
    },
    "outcome_status": {
      "type": "string",
      "enum": [
        "open",
        "realized"
      ]
    },
    "lineage_complete": { "type": "boolean", "default": false, "description": "True only when the decision outcome is traced through its opening lot and exact closure fills" },
    "outcome_quantity": { "type": "number" },
    "entry_fill_id": { "type": "string" },
    "entry_fill_ids": { "type": "string", "description": "JSON array of all partial entry Fill ids for the logical decision" },
    "exit_fill_ids": { "type": "string", "description": "JSON array of exact Fill ids allocated to this outcome" },
    "final_exit_at": { "type": "string", "format": "date-time", "description": "Latest allocated exit Fill timestamp; freezes realized analytics" },
    "labeled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "symbol",
    "action",
    "shares",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}
