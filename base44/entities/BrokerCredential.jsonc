{
  "name": "BrokerCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 the only field that can be matched; secret never leaves the server"
    },
    "broker": {
      "type": "string",
      "enum": [
        "alpaca",
        "ibkr",
        "tradestation",
        "custom"
      ]
    },
    "api_key": {
      "type": "string"
    },
    "api_secret": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paper",
        "live"
      ]
    },
    "account_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disconnected",
        "invalid"
      ],
      "default": "active"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "buying_power": {
      "type": "number"
    },
    "permissions": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "broker",
    "api_key",
    "api_secret",
    "mode"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}