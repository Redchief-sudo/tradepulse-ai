{
  "description": "Every 5 minutes: runs a system health check that detects stale scans, broker auth failures, pending order timeouts, reconciliation-blocked positions, and active kill switches. Critical issues trigger email + Telegram alerts.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "health_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runHealthCheck"
          },
          "then": "end",
          "x-base44": {
            "title": "Run system health check",
            "description": "Detects stale scans, broker failures, pending orders, blocked positions, and kill switch state"
          }
        }
      }
    ]
  },
  "name": "Health Check",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}