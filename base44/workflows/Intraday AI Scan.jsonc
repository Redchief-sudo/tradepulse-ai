{
  "name": "Intraday AI Scan",
  "description": "Every minute during US market hours: the sole Scan Coordinator consumer drains manual ScanRequests or runs scheduled scans. Browsers only enqueue requests.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "intraday_ai_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runScanCoordinator"
          },
          "then": "end",
          "x-base44": {
            "title": "Run scan coordinator",
            "description": "Serializes scan execution \u2014 consumes manual requests, runs scheduled scans"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "* 6-13 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
