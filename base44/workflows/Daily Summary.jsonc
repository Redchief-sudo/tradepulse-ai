{
  "description": "Every five minutes from 1:00-4:59 PM ET weekdays, checks Alpaca's clock and transitions at the actual exchange close, including shortened sessions.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleMarketClose"
          },
          "then": "end",
          "x-base44": {
            "title": "Transition closed assets and send daily P&L summary",
            "description": "Alpaca-authorized equity close transition followed by email and Telegram summary; continuous assets remain active"
          }
        }
      }
    ]
  },
  "name": "Daily Summary",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 13-16 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
