{
  "description": "Weekdays 9am PT: runs the 3-pass AI scan (Gemini scan -> Claude portfolio fit -> Claude adversarial veto) and auto-executes approved trades through the connected broker (or paper), then emails a summary.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_ai_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutonomousScanCycle"
          },
          "then": "end",
          "x-base44": {
            "title": "Run autonomous AI scan",
            "description": "3-pass scan + auto-execute approved trades"
          }
        }
      }
    ]
  },
  "name": "Autonomous AI Scan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}