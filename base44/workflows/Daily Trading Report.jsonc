{
  "description": "After the reconciliation window (6:05 PM ET weekdays): generates the final immutable daily trading journal.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_trading_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateDailyTradingReport",
            "args": {
              "final": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate daily trading journal",
            "description": "Aggregates all trades, fills, scans, and audit events into an immutable TradingSession record at market close"
          }
        }
      }
    ]
  },
  "name": "Daily Trading Report",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5 18 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
