{
  "description": "At US market close (4:05 PM ET weekdays): generates a comprehensive daily trading journal \u2014 aggregates all trades, fills, scan runs, audit events, and AI decisions into an immutable TradingSession record for institutional-grade auditing.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_trading_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateDailyTradingReport"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate daily trading journal",
            "description": "Aggregates all trades, fills, scans, and audit events into an immutable TradingSession record at market close"
          }
        }
      }
    ]
  },
  "name": "Daily Trading Report",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5 16 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}