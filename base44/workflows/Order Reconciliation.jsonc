{
  "description": "Continuously reconciles nonterminal broker orders \u2014 ingests unrecorded fills, detects canceled/rejected orders, finalizes settlement, and alerts on stale orders. Runs every 5 minutes during US market hours and the immediate after-hours window (weekdays 9:00-17:59 ET) to catch late broker updates and extended-hours fill reports.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 9-17 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Order Reconciliation",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "order_reconciliation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reconcile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runOrderReconciliation",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile pending orders",
            "description": "Ingest fills, detect cancellations, settle stale orders"
          }
        }
      }
    ]
  }
}