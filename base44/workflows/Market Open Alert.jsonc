{
  "name": "Market Open Alert",
  "description": "At 9:30 AM ET weekdays, verifies Alpaca's clock, starts the bot when safety gates allow, invokes the scan coordinator, and sends one Telegram status notification.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_open_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMarketOpenAlert"
          },
          "then": "end",
          "x-base44": {
            "title": "Send market open alert",
            "description": "Verify Alpaca open, start bot, invoke scan, and notify Telegram"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 9 * * 1-5",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
