{
  "name": "Settlement Processor",
  "description": "Every 5 minutes: processes pending SettlementEvents sequentially \u2014 the single-writer that projects lots, cash, holdings, trades, and P&L. No other function may directly mutate CashEntry, PositionLot, Holding, or final Trade settlement. Also handles crash recovery by picking up stale processing events.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "settlement_processor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "settle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processSettlementQueue"
          },
          "then": "end",
          "x-base44": {
            "title": "Process settlement queue",
            "description": "Single-writer settlement \u2014 projects lots, cash, holdings, trades from events"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}