{
  "name": "Outcome Labeling",
  "description": "Hourly outcome labeling \u2014 computes forward/realized returns, benchmark-relative return, and max adverse/favorable excursion for every executed AI buy decision.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "outcome_labeling",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "label": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runOutcomeLabeling"
          },
          "then": "end"
        }
      }
    ]
  }
}