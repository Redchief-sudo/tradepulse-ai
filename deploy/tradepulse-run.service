[Unit]
Description=TradePulse trading runtime (paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tradepulse-ai
# Process environment overrides .env: this unit can never trade live.
Environment=TRADEPULSE_EXECUTION_MODE=paper TRADEPULSE_LIVE_TRADING_ENABLED=false
# --resume: continue only an already-active session. An operator stop or a
# safety latch stays in force across restarts, while monitor, settlement and
# reconciliation keep protecting existing positions.
# The service and every operator command (`tradepulse start/stop/status`)
# read the database from .env. --require-database refuses to start (exit 78)
# unless the database the runtime actually resolved -- process environment
# first, then .env -- is the dedicated service database: tradepulse.db is
# preserved legacy evidence.
ExecStart=%h/tradepulse-ai/.venv/bin/tradepulse run --no-browser --resume --require-database sqlite:///tradepulse-service.db
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=900

[Install]
WantedBy=default.target
