TRADEPULSE_DATABASE_URL=sqlite:///tradepulse.db
TRADEPULSE_LOG_LEVEL=INFO
TRADEPULSE_EXECUTION_MODE=paper
TRADEPULSE_LIVE_TRADING_ENABLED=false
MARKET_DATA_TIMEOUT_SECONDS=10
BROKER_TIMEOUT_SECONDS=15
AI_TIMEOUT_SECONDS=45
MAX_RETRY_ATTEMPTS=3
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_MARKET_DATA_TIER=auto
FINNHUB_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
TRADEPULSE_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
TRADEPULSE_API_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADEPULSE_RISK_PROFILE=balanced
# Opt-in: when true, TRADEPULSE_RISK_PROFILE above becomes only a fallback --
# the active profile is instead picked from current account equity via a
# fixed ladder (<$10k: micro, $10k-$50k: aggressive, $50k-$250k: balanced,
# >=$250k: conservative). Off by default; see config/risk_profiles.py.
TRADEPULSE_AUTO_RISK_PROFILE_BY_EQUITY=false
TRADEPULSE_EQUITY_UNIVERSE_PATH=
TRADEPULSE_CRYPTO_UNIVERSE_PATH=
