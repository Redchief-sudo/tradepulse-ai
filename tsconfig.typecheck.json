{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "base44/shared/operationalTruth.ts",
    "base44/shared/scanConservation.ts",
    "base44/shared/settlementState.ts",
    "base44/shared/opportunity.ts",
    "base44/shared/executableUniverse.ts",
    "tests/operationalTruth.test.ts",
    "tests/scanConservation.test.ts",
    "tests/settlementState.test.ts",
    "tests/opportunity.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
