#env
.env
.env.*
!.env.example

# Logs
/logs
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.db
*.db-shm
*.db-wal
*.egg-info/

# Frontend (frontend/) build artifacts and dependencies
frontend/node_modules/
frontend/dist/

# Cached historical calibration data (tools/historical_data/) -- regeneratable
# from Alpaca, not source; see docs/exit-parameter-calibration.md
data/calibration/*
# Exception: the Generation-2 freeze manifest is a deliberate scientific
# commitment (the immutable contamination boundary), not regeneratable
# cache -- it must be tracked so its history is auditable. See
# docs/generation-2-calibration-freeze.md.
!data/calibration/generation_2_freeze_manifest.json
